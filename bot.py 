import json
import asyncio
import os
from pyrogram import Client, filters
from pyrogram.types import Message
from pyrogram.errors import PeerIdInvalid, UserIsBlocked, FloodWait
from config import *

app = Client(
    "auto_bot",
    api_id=API_ID,
    api_hash=API_HASH,
    bot_token=BOT_TOKEN
)

# LOAD DATA
def load_data():
    try:
        with open("data.json", "r") as f:
            return json.load(f)
    except FileNotFoundError:
        return {
            "welcome_msg": "",
            "photo": "",
            "video": "",
            "voice": "",
            "file": "",
            "link": ""
        }

# SAVE DATA
def save_data(data):
    with open("data.json", "w") as f:
        json.dump(data, f, indent=4)

# SAVE USERS
def save_user(user_id):
    if not os.path.exists("users.txt"):
        with open("users.txt", "w") as f:
            pass
            
    with open("users.txt", "a+") as f:
        f.seek(0)
        users = f.read().splitlines()
        if str(user_id) not in users:
            f.write(f"{user_id}\n")

# SEND ALL CONTENT (Sare media files ke sath)
async def send_all(user_id, first_name):
    data = load_data()

    # 1. Sabse pehle custom dynamic HELLO message bhejenge
    welcome_text = f"HELLO {first_name}! 👋\n\n"

    if data.get("welcome_msg"):
        welcome_text += data["welcome_msg"]
    else:
        welcome_text += "Welcome to the bot! Here is your requested content."

    try:
        # Message send karne ki koshish
        await app.send_message(user_id, welcome_text)
        await asyncio.sleep(1)

        # PHOTO
        if data.get("photo"):
            await app.send_photo(user_id, data["photo"])
            await asyncio.sleep(1)

        # VIDEO
        if data.get("video"):
            await app.send_video(user_id, data["video"])
            await asyncio.sleep(1)

        # VOICE
        if data.get("voice"):
            await app.send_voice(user_id, data["voice"])
            await asyncio.sleep(1)

        # FILE
        if data.get("file"):
            await app.send_document(user_id, data["file"])
            await asyncio.sleep(1)

        # LINK
        if data.get("link"):
            await app.send_message(user_id, data["link"])

        print(f"DM Sent successfully to {first_name} ({user_id}) ✅")

    except (PeerIdInvalid, UserIsBlocked):
        print(f"Cannot DM {first_name} ({user_id}): User has blocked the bot or restriction occurred. ❌")
    except FloodWait as e:
        print(f"Waiting for {e.value} seconds due to flood control... ⏳")
        await asyncio.sleep(e.value)
    except Exception as e:
        print(f"Error while sending DM to {user_id}: {e}")

# START COMMAND
@app.on_message(filters.command("start"))
async def start(client, message):
    user_id = message.from_user.id
    first_name = message.from_user.first_name or "User"

    save_user(user_id)
    try:
        await send_all(user_id, first_name)
    except Exception as e:
        print(f"Start command error: {e}")

# AUTO APPROVE JOIN REQUEST WITH INSTANT DM (Magic Sequence)
@app.on_chat_join_request()
async def approve(client, join_request):
    user_id = join_request.from_user.id
    chat_id = join_request.chat.id
    user_name = join_request.from_user.first_name or "User"

    # User ko list mein save karo
    save_user(user_id)

    try:
        # STEP 1: PEHLE DM BHEJO (Temporary permission ka use karke)
        print(f"Sending welcome DM & Media to {user_name} ({user_id})...")
        await send_all(user_id, user_name)
        
        # Thoda sa gap taaki processing smoothly ho
        await asyncio.sleep(2)

        # STEP 2: AB REQUEST APPROVE KARO
        await client.approve_chat_join_request(
            chat_id=chat_id,
            user_id=user_id
        )
        print(f"Approved {user_name} ({user_id}) successfully! ✅")

    except Exception as e:
        print(f"Approve/DM Error for {user_name}: {e}")

# SET MESSAGE
@app.on_message(filters.command("setmsg") & filters.user(ADMIN_ID))
async def setmsg(client, message):
    if len(message.command) < 2:
        return await message.reply("Usage:\n/setmsg Write your message here")

    text = message.text.split(None, 1)[1]
    data = load_data()
    data["welcome_msg"] = text
    save_data(data)
    await message.reply("Message Saved ✅")

