import json
from pyrogram import Client, filters
from pyrogram.types import Message
from config import *

app = Client(
    "auto_bot",
    api_id=API_ID,
    api_hash=API_HASH,
    bot_token=BOT_TOKEN
)

# LOAD DATA
def load_data():
    with open("data.json", "r") as f:
        return json.load(f)

# SAVE DATA
def save_data(data):
    with open("data.json", "w") as f:
        json.dump(data, f, indent=4)

# SAVE USERS
def save_user(user_id):

    with open("users.txt", "a+") as f:

        f.seek(0)

        users = f.read().splitlines()

        if str(user_id) not in users:
            f.write(f"{user_id}\n")

# SEND ALL CONTENT
async def send_all(user_id):

    data = load_data()

    # MESSAGE
    if data["welcome_msg"]:

        await app.send_message(
            user_id,
            data["welcome_msg"]
        )

    # PHOTO
    if data["photo"]:

        await app.send_photo(
            user_id,
            data["photo"]
        )

    # VIDEO
    if data["video"]:

        await app.send_video(
            user_id,
            data["video"]
        )

    # VOICE
    if data["voice"]:

        await app.send_voice(
            user_id,
            data["voice"]
        )

    # FILE
    if data["file"]:

        await app.send_document(
            user_id,
            data["file"]
        )

    # LINK
    if data["link"]:

        await app.send_message(
            user_id,
            data["link"]
        )

# START COMMAND
@app.on_message(filters.command("start"))
async def start(client, message):

    user_id = message.from_user.id

    save_user(user_id)

    try:

        await send_all(user_id)

    except Exception as e:
        print(e)

# AUTO APPROVE JOIN REQUEST
@app.on_chat_join_request()
async def approve(client, join_request):

    user_id = join_request.user_chat_id

    chat_id = join_request.chat.id

    try:

        # APPROVE REQUEST
        await client.approve_chat_join_request(
            chat_id,
            join_request.from_user.id
        )

        save_user(user_id)

        # SEND DM
        await send_all(user_id)

        print(f"Approved: {user_id}")

    except Exception as e:
        print(e)

# SET MESSAGE
@app.on_message(filters.command("setmsg") & filters.user(ADMIN_ID))
async def setmsg(client, message):

    if len(message.command) < 2:

        return await message.reply(
            "Usage:\n/setmsg hello"
        )

    text = message.text.split(None, 1)[1]

    data = load_data()

    data["welcome_msg"] = text

    save_data(data)

    await message.reply(
        "Message Saved ✅"
    )

# SET PHOTO
@app.on_message(filters.command("setphoto") & filters.user(ADMIN_ID))
async def setphoto(client, message):

    if not message.reply_to_message:

        return await message.reply(
            "Reply To Photo"
        )

    photo = message.reply_to_message.photo

    if not photo:

        return await message.reply(
            "Reply To Photo"
        )

    data = load_data()

    data["photo"] = photo.file_id

    save_data(data)

    await message.reply(
        "Photo Saved ✅"
    )

