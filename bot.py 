# BROADCAST
@app.on_message(filters.command("broadcast") & filters.user(ADMIN_ID))
async def broadcast(client, message):
    if not message.reply_to_message:
        return await message.reply("Reply To Any Message")

    if not os.path.exists("users.txt"):
        return await message.reply("No users found to broadcast.")

    with open("users.txt", "r") as f:
        users = f.read().splitlines()

    total = 0
    failed = 0
    msg = await message.reply("Broadcast Started...")

    for user in users:
        try:
            await message.reply_to_message.copy(int(user))
            total += 1
            await asyncio.sleep(0.1) # Flood control
        except:
            failed += 1

    await msg.edit(
        f"Done ✅\n\nSuccess: {total}\nFailed: {failed}"
    )

# USER COUNT
@app.on_message(filters.command("users") & filters.user(ADMIN_ID))
async def users(client, message):
    if not os.path.exists("users.txt"):
        return await message.reply("Total Users: 0")
        
    with open("users.txt", "r") as f:
        users = f.read().splitlines()
    await message.reply(f"Total Users: {len(users)}")

